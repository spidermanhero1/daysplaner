# Пароль на вход. В проде без него сервер не стартует. В npm run dev можно не задавать.
# На Vercel задай его в Environment Variables.
PLANDAYS_PASSWORD=

# Локальный файл. На Vercel не используется.
PLANDAYS_DB=data/plandays.sqlite

# Прод на Vercel. Marketplace → Turso подставит оба сам. Регион ближе к дому: Сингапур.
# Если задать их и дома, npm run dev пишет в ту же базу, что и сайт.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

PLANDAYS_PORT=8787

# 1 — перед приложением стоит HTTPS-прокси (Caddyfile). Тогда Node слушает только 127.0.0.1.
PLANDAYS_HTTPS=0

# Либо TLS прямо в Node, и PLANDAYS_HTTPS не нужен.
PLANDAYS_TLS_CERT=
PLANDAYS_TLS_KEY=

# Необязательно. Иначе: прод с сертификатом — все интерфейсы, прод за прокси — только localhost, dev — все интерфейсы.
PLANDAYS_HOST=
